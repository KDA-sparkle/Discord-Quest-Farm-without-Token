<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quest Spoofer" Width="1092" Height="792" MinWidth="932" MinHeight="672"
        WindowStyle="None" Background="#111214"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="60" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Palette neutre ; "Accent" / "Cyan" / "AccentSoft" sont remplacees par le code (couleur d'accent) -->
    <SolidColorBrush x:Key="Bg"       Color="#111214"/>
    <SolidColorBrush x:Key="Surface"  Color="#17181B"/>
    <SolidColorBrush x:Key="Surface2" Color="#1D1E22"/>
    <SolidColorBrush x:Key="Line"     Color="#25262B"/>
    <SolidColorBrush x:Key="Text"     Color="#ECECEE"/>
    <SolidColorBrush x:Key="Muted"    Color="#9FA0A8"/>
    <SolidColorBrush x:Key="Dim"      Color="#6B6C74"/>
    <SolidColorBrush x:Key="Green"    Color="#3FB37F"/>
    <SolidColorBrush x:Key="Red"      Color="#E5484D"/>
    <SolidColorBrush x:Key="Gold"     Color="#E5B33A"/>
    <SolidColorBrush x:Key="Accent"     Color="#7B83EB"/>
    <SolidColorBrush x:Key="Cyan"       Color="#7B83EB"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#267B83EB"/>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- Scrollbar fine -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="MinWidth" Value="6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="t" Background="#2C2D33" CornerRadius="3"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="#3A3B42"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#202126"/>
      <Setter Property="Foreground" Value="#ECECEE"/>
      <Setter Property="BorderBrush" Value="#2E2F35"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>

    <!-- Boutons de la barre de titre : fond qui apparait en fondu -->
    <Style x:Key="TitleBtn" TargetType="Button">
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="2,0,0,0"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="8">
              <Border.Background><SolidColorBrush Color="#00232428"/></Border.Background>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#FF232428" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#00232428" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBtn}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="8">
              <Border.Background><SolidColorBrush Color="#00E5484D"/></Border.Background>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#FFE5484D" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#00E5484D" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Bouton principal : couleur d'accent unie, voile clair au survol -->
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border CornerRadius="8" Background="{DynamicResource Accent}"/>
              <Border x:Name="veil" CornerRadius="8" Background="White" Opacity="0" IsHitTestVisible="False"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="veil" Storyboard.TargetProperty="Opacity" To="0.1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="veil" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="veil" Property="Opacity" Value="0.18"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Bouton secondaire / petit bouton / bouton icone : surface claire qui s'eclaircit en fondu -->
    <Style x:Key="Chip" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <Border.Background><SolidColorBrush Color="#FF1D1E22"/></Border.Background>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#FF26272C" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#FF1D1E22" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Chip}">
      <Setter Property="Height" Value="40"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="18,0"/>
    </Style>
    <Style x:Key="IconChip" TargetType="Button" BasedOn="{StaticResource Chip}">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Bouton d'arret : discret, rouge au survol -->
    <Style x:Key="Danger" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Red}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1">
              <Border.Background><SolidColorBrush Color="#00E5484D"/></Border.Background>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#1FE5484D" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#00E5484D" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Onglet : couleurs pilotees par le code (Set-SegStyle) -->
    <Style x:Key="Seg" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Margin" Value="2,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Croix sur une carte de session -->
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="8">
              <Border.Background><SolidColorBrush Color="#00E5484D"/></Border.Background>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Red}"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#1FE5484D" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#00E5484D" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Croix minuscule sur un jeu de la file -->
    <Style x:Key="ChipX" TargetType="Button">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="7.5"/>
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="5" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#2E2F35"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Etoile favori : apparait en fondu au survol, reste visible si favori -->
    <Style x:Key="Star" TargetType="Button">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="Content" Value="&#xE734;"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ToolTip" Value="Favori (Ctrl+D)"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Gold}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
          <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsFav}" Value="True">
          <Setter Property="Content" Value="&#xE735;"/>
          <Setter Property="Foreground" Value="{StaticResource Gold}"/>
          <Setter Property="Tag" Value="fav"/>
        </DataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions><Condition Binding="{Binding IsFav}" Value="True"/></MultiDataTrigger.Conditions>
          <MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
        </MultiDataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Interrupteur on/off -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="38" Height="22" Background="Transparent">
              <Border x:Name="track" CornerRadius="11" Background="#2A2B31"/>
              <Border x:Name="on" CornerRadius="11" Background="{DynamicResource Accent}" Opacity="0"/>
              <Ellipse x:Name="knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="slide"/></Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Menus contextuels (minuterie, listes) -->
    <!-- Police forcee : sinon le menu herite de la police d'icones du bouton qui l'ouvre (texte en carres) -->
    <Style TargetType="ContextMenu">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="#1D1E22" BorderBrush="#2E2F35" BorderThickness="1" CornerRadius="10" Padding="4">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="#ECECEE"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="10,7" MinWidth="240">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="chk" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Visibility="Hidden"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#2A2B30"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="chk" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#5C5D65"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Separator">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator"><Border Height="1" Background="#2A2B30" Margin="6,4"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SearchBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SearchWrap" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="BorderBrush" Value="#3A3B42"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Panel}">
      <Setter Property="Padding" Value="18,14"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style x:Key="Stat" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Margin" Value="0,4,0,2"/>
    </Style>
    <Style x:Key="StatSub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Ligne de reglage -->
    <Style x:Key="SetTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="13.5"/>
    </Style>
    <Style x:Key="SetDesc" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SetRow" TargetType="Border">
      <Setter Property="Padding" Value="0,12"/>
      <Setter Property="BorderBrush" Value="#222328"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style x:Key="SetHead" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,20,0,2"/>
    </Style>

    <!-- Ligne de la liste des jeux : survol et selection en fondu -->
    <Style x:Key="GameItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,4,1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="b" CornerRadius="8" Padding="10,7,6,7">
                <Border.Background><SolidColorBrush Color="#0026272C"/></Border.Background>
                <ContentPresenter/>
              </Border>
              <!-- Teinte d'accent de la ligne selectionnee (calque separe pour ne pas gener l'animation de survol) -->
              <Border x:Name="sel" CornerRadius="8" Background="{DynamicResource AccentSoft}" Opacity="0" IsHitTestVisible="False"/>
              <Border x:Name="bar" Width="3" HorizontalAlignment="Left" Margin="0,11" CornerRadius="2"
                      Background="{DynamicResource Accent}" Opacity="0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#FF1F2024" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#0026272C" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                  <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                  <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="GameTpl">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid Width="34" Height="34">
          <Border CornerRadius="8" Background="#24252A">
            <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Muted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Image Source="{Binding IconUrl}" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality">
            <Image.Clip><RectangleGeometry Rect="0,0,34,34" RadiusX="8" RadiusY="8"/></Image.Clip>
          </Image>
        </Grid>
        <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding ExePath}" Foreground="{StaticResource Dim}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
        </StackPanel>
        <!-- Temps deja joue avec l'outil (vert = compte pour Game Variety) -->
        <Border Grid.Column="2" CornerRadius="6" Padding="7,2" Margin="0,0,4,0" VerticalAlignment="Center">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="#24252A"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Played}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding IsPlayed}" Value="True"><Setter Property="Background" Value="#1A3FB37F"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding Played}" FontSize="11" Typography.NumeralAlignment="Tabular">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#9FA0A8"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsPlayed}" Value="True"><Setter Property="Foreground" Value="#3FB37F"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Border>
        <Button Grid.Column="3" Style="{StaticResource Star}" Tag="{Binding}" VerticalAlignment="Center"/>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="QueueTpl">
      <Border CornerRadius="8" Background="#24252A" Padding="4,3,3,3" Margin="0,0,6,6">
        <StackPanel Orientation="Horizontal">
          <Grid Width="18" Height="18" Margin="0,0,7,0">
            <Border CornerRadius="5" Background="#2E2F35">
              <TextBlock Text="{Binding Initial}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Image Source="{Binding IconUrl}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality">
              <Image.Clip><RectangleGeometry Rect="0,0,18,18" RadiusX="5" RadiusY="5"/></Image.Clip>
            </Image>
          </Grid>
          <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="12" MaxWidth="160"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          <Button Style="{StaticResource ChipX}" Content="&#xE711;" Tag="{Binding}" Margin="6,0,0,0" ToolTip="Retirer de la file"/>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Carte de session active -->
    <DataTemplate x:Key="ActiveTpl">
      <Border Margin="0,0,4,8" Padding="10,10,12,10" Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <!-- Bande de couleur selon le type : vert = lancement manuel, accent = rotation, ambre = quete -->
          <Border Width="3" CornerRadius="2" Margin="0,2,10,2">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Green}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Kind}" Value="Rotation"><Setter Property="Background" Value="{DynamicResource Accent}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="Quête"><Setter Property="Background" Value="#F2A93B"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
          </Border>
          <Grid Grid.Column="1" Width="38" Height="38" VerticalAlignment="Center">
            <Border CornerRadius="9" Background="#2A2B30">
              <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Muted}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Image Source="{Binding IconUrl}" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality">
              <Image.Clip><RectangleGeometry Rect="0,0,38,38" RadiusX="9" RadiusY="9"/></Image.Clip>
            </Image>
            <Ellipse Width="11" Height="11" Fill="{StaticResource Green}" Stroke="#1D1E22" StrokeThickness="2"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"/>
          </Grid>
          <StackPanel Grid.Column="2" Margin="12,0,12,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding ExePath}" Foreground="{StaticResource Dim}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="3" Margin="0,0,10,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Elapsed}" Foreground="{StaticResource Text}" FontFamily="{StaticResource Display}" FontSize="17"
                       FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding PidLabel}" Foreground="{StaticResource Dim}" FontSize="11" HorizontalAlignment="Right"/>
          </StackPanel>
          <Button Grid.Column="4" Style="{StaticResource IconBtn}" Content="&#xE711;" Tag="{Binding}" ToolTip="Arrêter cette session (Suppr)"/>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid Margin="22,0,22,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="60"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- En-tete -->
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Logo : meme dessin que l'icone (QsIcon) -->
          <Grid Width="32" Height="32">
            <Border CornerRadius="8">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#8B93FF" Offset="0"/>
                  <GradientStop Color="#6C4CF5" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
            <Path Fill="#FFCD56" Data="M24.8,3 L26.1,5.9 L29,7.2 L26.1,8.5 L24.8,11.4 L23.5,8.5 L20.6,7.2 L23.5,5.9 Z"/>
          </Grid>
          <TextBlock Text="Quest Spoofer" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="Simulateur de présence Discord" Foreground="{StaticResource Dim}" FontSize="12.5" Margin="10,1,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="Pill" CornerRadius="8" Padding="11,6" Margin="0,0,8,0" Background="{StaticResource Surface2}"
                  BorderBrush="{StaticResource Line}" BorderThickness="1" WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="PillDot" Width="7" Height="7" Fill="{StaticResource Dim}" VerticalAlignment="Center"/>
              <TextBlock x:Name="PillText" Text="Synchronisation" FontSize="12" Foreground="{StaticResource Muted}" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Button x:Name="BtnTimer" Style="{StaticResource TitleBtn}" Width="Auto" Margin="0,0,2,0"
                  ToolTip="Minuterie : tout arrêter après un délai, puis mettre en veille ou éteindre le PC">
            <StackPanel Orientation="Horizontal" Margin="10,0">
              <TextBlock Text="&#xE916;" FontSize="12" VerticalAlignment="Center"/>
              <TextBlock x:Name="TimerText" Text="Minuterie" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12.5"
                         Typography.NumeralAlignment="Tabular" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnWidget" Style="{StaticResource TitleBtn}" Content="&#xE8A7;" ToolTip="Mini-widget toujours visible"/>
          <Button x:Name="BtnSettings" Style="{StaticResource TitleBtn}" Content="&#xE713;" FontSize="12.5" ToolTip="Réglages"/>
          <Border Width="1" Height="18" Background="{StaticResource Line}" Margin="8,0,6,0"/>
          <Button x:Name="BtnTray" Style="{StaticResource TitleBtn}" Content="&#xE70D;" ToolTip="Envoyer dans la zone de notification (à côté de l'horloge)"/>
          <Button x:Name="BtnMin" Style="{StaticResource TitleBtn}" Content="&#xE921;" ToolTip="Réduire"/>
          <Button x:Name="BtnClose" Style="{StaticResource CloseBtn}" Content="&#xE8BB;" ToolTip="Fermer (arrête tout)"/>
        </StackPanel>
      </Grid>

      <!-- Statistiques -->
      <Grid Grid.Row="1" Margin="0,2,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.25*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Tile}">
          <StackPanel>
            <Grid>
              <TextBlock Text="Catalogue" Style="{StaticResource Label}" VerticalAlignment="Center"/>
              <Border Width="28" Height="28" CornerRadius="8" Background="#224EA8F7" HorizontalAlignment="Right" Margin="0,-4,-4,-6">
                <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="#4EA8F7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <TextBlock x:Name="StatGames" Text="—" Style="{StaticResource Stat}"/>
            <TextBlock x:Name="StatGamesSub" Text="jeux détectables par Discord" Style="{StaticResource StatSub}"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Tile}">
          <StackPanel>
            <Grid>
              <TextBlock Text="Sessions" Style="{StaticResource Label}" VerticalAlignment="Center"/>
              <Border Width="28" Height="28" CornerRadius="8" Background="#223FB37F" HorizontalAlignment="Right" Margin="0,-4,-4,-6">
                <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="#3FB37F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <TextBlock x:Name="StatActive" Text="0" Style="{StaticResource Stat}" Foreground="{DynamicResource Accent}"/>
            <TextBlock x:Name="StatActiveSub" Text="faux jeux en cours" Style="{StaticResource StatSub}"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="4" Style="{StaticResource Tile}">
          <StackPanel>
            <Grid>
              <TextBlock Text="Temps en cours" Style="{StaticResource Label}" VerticalAlignment="Center"/>
              <Border Width="28" Height="28" CornerRadius="8" Background="#22F2A93B" HorizontalAlignment="Right" Margin="0,-4,-4,-6">
                <TextBlock Text="&#xE916;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="#F2A93B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <TextBlock x:Name="StatTime" Text="00:00:00" Style="{StaticResource Stat}"/>
            <TextBlock Text="toutes sessions confondues" Style="{StaticResource StatSub}"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="6" Style="{StaticResource Tile}" Background="{DynamicResource AccentSoft}"
                ToolTip="Jeux différents lancés avec l'outil pendant au moins 15 min, Discord ouvert">
          <StackPanel>
            <Grid>
              <TextBlock Text="Game Variety · jeux uniques" Style="{StaticResource Label}" VerticalAlignment="Center"/>
              <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Right" Margin="0,-4,-4,-6">
                <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <TextBlock Style="{StaticResource Stat}">
              <Run x:Name="StatUnique" Text="0" Foreground="{DynamicResource Accent}"/><Run x:Name="StatUniqueGoal" Text=" / 2" Foreground="#6B6C74" FontSize="18"/>
            </TextBlock>
            <TextBlock x:Name="StatUniqueSub" Text="prochain palier : Sampler" Style="{StaticResource StatSub}"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Corps -->
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>

        <!-- Catalogue -->
        <Border Grid.Column="0" Style="{StaticResource Panel}">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="2,0,0,12">
              <TextBlock Text="Catalogue" Style="{StaticResource Section}" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="TabAll" Style="{StaticResource Seg}" Content="Tous"/>
                <Button x:Name="TabFav" Style="{StaticResource Seg}" Content="Favoris"/>
                <Button x:Name="TabRecent" Style="{StaticResource Seg}" Content="Récents"/>
                <Button x:Name="TabPlayed" Style="{StaticResource Seg}" Content="Joués" ToolTip="Jeux déjà lancés avec l'outil, et leur temps cumulé"/>
              </StackPanel>
            </Grid>
            <Border DockPanel.Dock="Top" Style="{StaticResource SearchWrap}" Height="38" Margin="0,0,0,10">
              <Grid>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource Dim}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock x:Name="SearchHint" Text="Rechercher un jeu" Foreground="{StaticResource Dim}" FontSize="13.5"
                           VerticalAlignment="Center" Margin="36,0,0,0" IsHitTestVisible="False"/>
                <TextBox x:Name="Search" Style="{StaticResource SearchBox}" Margin="34,0,100,0"/>
                <TextBlock x:Name="ResultCount" Foreground="{StaticResource Dim}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,0,12,0" IsHitTestVisible="False" Typography.NumeralAlignment="Tabular"/>
              </Grid>
            </Border>
            <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button x:Name="BtnLaunch" Style="{StaticResource Primary}" IsEnabled="False" ToolTip="Entrée">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock Text="Lancer le spoof" Margin="9,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="BtnQueue" Grid.Column="2" Style="{StaticResource Ghost}" IsEnabled="False" ToolTip="Ajouter à la rotation (Ctrl+Entrée)">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center"/>
                  <TextBlock Text="Rotation" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Grid>
            <Grid>
              <ListBox x:Name="Games" Background="Transparent" BorderThickness="0"
                       ItemContainerStyle="{StaticResource GameItem}" ItemTemplate="{StaticResource GameTpl}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                       VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"/>
              <TextBlock x:Name="ListEmpty" Visibility="Collapsed" Foreground="{StaticResource Dim}" FontSize="13"
                         TextAlignment="Center" LineHeight="20" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="24,0"/>
              <StackPanel x:Name="Loader" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="28" Height="28" HorizontalAlignment="Center">
                  <Ellipse Stroke="#2A2B30" StrokeThickness="2.5"/>
                  <Path Data="M14,1.25 A12.75,12.75 0 0 1 26.75,14" Stroke="{DynamicResource Accent}" StrokeThickness="2.5"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                    <!-- Anime depuis le code, et arrete une fois le catalogue charge -->
                    <Path.RenderTransform><RotateTransform x:Name="SpinRot"/></Path.RenderTransform>
                  </Path>
                </Grid>
                <TextBlock Text="Chargement du catalogue…" Foreground="{StaticResource Dim}" FontSize="12.5" Margin="0,12,0,0" HorizontalAlignment="Center"/>
              </StackPanel>
            </Grid>
          </DockPanel>
        </Border>

        <!-- Panneau de droite : Sessions / Quete / Stats -->
        <Border Grid.Column="2" Style="{StaticResource Panel}">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="2,0,0,12">
              <TextBlock x:Name="PageTitle" Text="Sessions" Style="{StaticResource Section}" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PageTabSessions" Style="{StaticResource Seg}" Content="Sessions"/>
                <Button x:Name="PageTabQuest" Style="{StaticResource Seg}" Content="Quête"/>
                <Button x:Name="PageTabStats" Style="{StaticResource Seg}" Content="Stats"/>
              </StackPanel>
            </Grid>
            <Grid>

          <!-- ===== Page SESSIONS ===== -->
          <DockPanel x:Name="PageSessions">
            <!-- Rotation automatique -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="16,14" Style="{StaticResource Card}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <DockPanel VerticalAlignment="Center">
                    <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentSoft}" Margin="0,0,12,0">
                      <TextBlock Text="&#xE8EE;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource Accent}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Rotation automatique" Foreground="{StaticResource Text}" FontSize="13.5" FontWeight="SemiBold"/>
                      <TextBlock x:Name="RotInfo" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </DockPanel>
                  <TextBlock x:Name="RotCountdown" Grid.Column="1" Text="--:--" FontFamily="{StaticResource Display}" FontSize="24" FontWeight="SemiBold"
                             Typography.NumeralAlignment="Tabular" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
                <Grid Height="4" Margin="0,12,0,12">
                  <Border Background="#2A2B30" CornerRadius="2"/>
                  <Border x:Name="RotBar" Background="{DynamicResource Accent}" CornerRadius="2"/>
                </Grid>
                <ScrollViewer MaxHeight="68" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="QueueList" ItemTemplate="{StaticResource QueueTpl}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  </ItemsControl>
                </ScrollViewer>
                <Grid Margin="0,4,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource SearchWrap}" Height="32" Width="92" ToolTip="Durée par jeu">
                    <Grid>
                      <TextBox x:Name="RotMinutes" Text="30" Style="{StaticResource SearchBox}" Margin="12,0,34,0" MaxLength="3"/>
                      <TextBlock Text="min" Foreground="{StaticResource Dim}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnLists" Style="{StaticResource IconChip}" Content="&#xE8FD;" Margin="0,0,6,0"
                            ToolTip="Listes enregistrées · exporter / importer une file"/>
                    <Button x:Name="BtnRandom" Style="{StaticResource IconChip}" Content="&#xE8B1;" Margin="0,0,6,0"
                            ToolTip="Ajouter 10 jeux connus, jamais joués"/>
                    <Button x:Name="BtnClearQueue" Style="{StaticResource IconChip}" Content="&#xE74D;" Margin="0,0,6,0" ToolTip="Vider la file"/>
                    <Button x:Name="BtnPause" Style="{StaticResource IconChip}" Content="&#xE769;" Margin="0,0,6,0" Visibility="Collapsed"
                            ToolTip="Pause / reprise (Ctrl+Alt+S, même quand l'outil est caché)"/>
                    <Button x:Name="BtnNext" Style="{StaticResource IconChip}" Content="&#xE893;" Margin="0,0,6,0" Visibility="Collapsed"
                            ToolTip="Passer au jeu suivant"/>
                  </StackPanel>
                  <Button x:Name="BtnRotate" Grid.Column="3" Style="{StaticResource Primary}" Height="32" Width="100" FontSize="12.5" Content="Démarrer"/>
                </Grid>
              </StackPanel>
            </Border>

            <Button x:Name="BtnStopAll" DockPanel.Dock="Bottom" Style="{StaticResource Danger}" Margin="0,12,0,0" IsEnabled="False">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE71A;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="Tout arrêter" Margin="8,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Grid>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Active" ItemTemplate="{StaticResource ActiveTpl}"/>
              </ScrollViewer>
              <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="#3A3B42" HorizontalAlignment="Center"/>
                <TextBlock Text="Aucune session" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="Choisis un jeu à gauche puis lance le spoof." Foreground="{StaticResource Dim}" FontSize="12.5"
                           TextAlignment="Center" Margin="0,4,0,0"/>
              </StackPanel>
            </Grid>
          </DockPanel>

          <!-- ===== Page QUETE ===== -->
          <ScrollViewer x:Name="PageQuest" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,0">
              <Border Padding="18,16" Style="{StaticResource Card}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="8" Background="#26F2A93B" Margin="0,0,10,0">
                      <TextBlock Text="&#xE7C1;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="#F2A93B"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Mode quête" Foreground="{StaticResource Text}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,14" LineHeight="19"
                             Text="Choisis le jeu de la quête dans le catalogue et indique la durée demandée. L'outil le lance, compte, te prévient et s'arrête tout seul."/>
                  <Border Padding="12" CornerRadius="10" Background="#24252A">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Grid Width="42" Height="42">
                        <Border CornerRadius="10" Background="#2E2F35">
                          <TextBlock x:Name="QuestInitial" Text="?" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource Muted}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Image x:Name="QuestIcon" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality">
                          <Image.Clip><RectangleGeometry Rect="0,0,42,42" RadiusX="10" RadiusY="10"/></Image.Clip>
                        </Image>
                      </Grid>
                      <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="QuestName" Text="Aucun jeu sélectionné" Foreground="{StaticResource Text}" FontSize="14.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="QuestExe" Text="Sélectionne un jeu dans le catalogue à gauche" Foreground="{StaticResource Dim}"
                                   FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SearchWrap}" Height="36" Width="96" ToolTip="Durée demandée par la quête">
                      <Grid>
                        <TextBox x:Name="QuestMinutes" Text="15" Style="{StaticResource SearchBox}" Margin="12,0,36,0" MaxLength="3"/>
                        <TextBlock Text="min" Foreground="{StaticResource Dim}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"
                                ToolTip="Ajoute 2 minutes au cas où Discord valide la quête un peu en retard">
                      <CheckBox x:Name="ChkQuestMargin" Style="{StaticResource Switch}" IsChecked="True" VerticalAlignment="Center"/>
                      <TextBlock Text="2 min de marge" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="BtnQuest" Grid.Column="3" Style="{StaticResource Primary}" Height="36" Width="160" FontSize="12.5" IsEnabled="False">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="Lancer la quête" Margin="8,0,0,0" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </Grid>
                </StackPanel>
              </Border>

              <Border x:Name="QuestRun" Visibility="Collapsed" Margin="0,12,0,0" Padding="18,16" Style="{StaticResource Card}">
                <StackPanel>
                  <Grid>
                    <TextBlock x:Name="QuestInfo" Foreground="{StaticResource Muted}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,60,0"/>
                    <TextBlock x:Name="QuestPct" Foreground="{StaticResource Dim}" FontSize="12" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                  </Grid>
                  <TextBlock x:Name="QuestCountdown" Text="15:00" FontFamily="{StaticResource Display}" FontSize="52" FontWeight="SemiBold"
                             Typography.NumeralAlignment="Tabular" Foreground="{StaticResource Text}" HorizontalAlignment="Center" Margin="0,4,0,10"/>
                  <Grid Height="4">
                    <Border Background="#2A2B30" CornerRadius="2"/>
                    <Border x:Name="QuestBar" Background="{DynamicResource Accent}" CornerRadius="2"/>
                  </Grid>
                  <Button x:Name="BtnQuestStop" Style="{StaticResource Danger}" Height="36" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE71A;" FontFamily="{StaticResource Icons}" FontSize="10.5" VerticalAlignment="Center"/>
                      <TextBlock Text="Arrêter la quête" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>

              <TextBlock Margin="2,14,2,0" Foreground="{StaticResource Dim}" FontSize="12" TextWrapping="Wrap" LineHeight="18"
                         Text="Discord doit rester ouvert : le compte à rebours se met en pause s'il est fermé. La quête tourne à part de la rotation, les deux peuvent fonctionner en même temps."/>
            </StackPanel>
          </ScrollViewer>

          <!-- ===== Page STATS ===== -->
          <ScrollViewer x:Name="PageStats" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="14,12">
                  <StackPanel>
                    <TextBlock Text="Temps simulé" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="StatsTotal" Text="0 min" Style="{StaticResource Stat}" FontSize="20"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12">
                  <StackPanel>
                    <TextBlock Text="Jeux lancés" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="StatsGames" Text="0" Style="{StaticResource Stat}" FontSize="20"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="14,12">
                  <StackPanel>
                    <TextBlock Text="Validés (15 min)" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="StatsValid" Text="0" Style="{StaticResource Stat}" FontSize="20" Foreground="{StaticResource Green}"/>
                  </StackPanel>
                </Border>
              </Grid>
              <Border Margin="0,8,0,0" Padding="16,14" Style="{StaticResource Card}">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="Temps simulé · 14 derniers jours" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ChartMax" Foreground="{StaticResource Dim}" FontSize="12" HorizontalAlignment="Right"/>
                  </Grid>
                  <Grid x:Name="Chart" Height="128" Margin="0,12,0,0"/>
                </StackPanel>
              </Border>
              <Border Margin="0,8,0,0" Padding="16,14" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Jeux les plus joués" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold"/>
                  <StackPanel x:Name="TopGames" Margin="0,12,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

            </Grid>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Barre d'etat -->
      <Grid Grid.Row="3" Margin="2,12,2,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Status" Text="Initialisation" FontSize="12" Foreground="{StaticResource Muted}"
                   TextTrimming="CharacterEllipsis" Margin="0,0,24,0"/>
        <TextBlock Grid.Column="1" Foreground="#55565E" FontSize="11.5"
                   Text="Ctrl+F chercher · Entrée lancer · Ctrl+Entrée rotation · Ctrl+D favori · Suppr arrêter · Ctrl+Alt+S pause"/>
      </Grid>
    </Grid>

    <!-- ===== Reglages (par-dessus tout, apparait en fondu) ===== -->
    <Grid x:Name="SettingsOverlay" Visibility="Collapsed">
      <Border x:Name="SettingsBackdrop" Background="#B3000000"/>
      <Border x:Name="SettingsCard" Width="620" Margin="0,40" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="14"
              Background="#18191C" BorderBrush="#2A2B30" BorderThickness="1" Padding="26,20" WindowChrome.IsHitTestVisibleInChrome="True">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
            <TextBlock Text="Réglages" Foreground="{StaticResource Text}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="BtnSettingsClose" Style="{StaticResource TitleBtn}" Content="&#xE8BB;" HorizontalAlignment="Right" Margin="0" ToolTip="Fermer (Échap)"/>
          </Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="560">
            <StackPanel Margin="0,0,6,0">

              <TextBlock Text="Apparence" Style="{StaticResource SetHead}"/>
              <Border Style="{StaticResource SetRow}">
                <Grid>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Couleur d'accent" Style="{StaticResource SetTitle}"/>
                    <TextBlock x:Name="AccentName" Text="Indigo" Style="{StaticResource SetDesc}"/>
                  </StackPanel>
                  <StackPanel x:Name="AccentList" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SetRow}">
                <Grid>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,200,0">
                    <TextBlock Text="Langue" Style="{StaticResource SetTitle}"/>
                    <TextBlock Text="Toute l'interface change de langue, tout de suite." Style="{StaticResource SetDesc}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="LangFr" Style="{StaticResource Seg}" Content="Français"/>
                    <Button x:Name="LangEn" Style="{StaticResource Seg}" Content="English"/>
                  </StackPanel>
                </Grid>
              </Border>

              <TextBlock Text="Démarrage" Style="{StaticResource SetHead}"/>
              <Border Style="{StaticResource SetRow}">
                <Grid>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,70,0">
                    <TextBlock Text="Lancer avec Windows" Style="{StaticResource SetTitle}"/>
                    <TextBlock Text="Démarre discrètement dans la zone de notification à l'ouverture de session." Style="{StaticResource SetDesc}"/>
                  </StackPanel>
                  <CheckBox x:Name="ChkAutostart" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SetRow}">
                <Grid>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                    <TextBlock Text="Raccourci sur le bureau" Style="{StaticResource SetTitle}"/>
                    <TextBlock x:Name="ShortcutDesc" Text="Ouvre l'outil avec sa vraie icône, sans console." Style="{StaticResource SetDesc}"/>
                  </StackPanel>
                  <Button x:Name="BtnShortcut" Style="{StaticResource Chip}" Content="Créer" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </Border>

              <TextBlock Text="Faux jeux" Style="{StaticResource SetHead}"/>
              <Border Style="{StaticResource SetRow}">
                <Grid>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,140,0">
                    <TextBlock Text="Fenêtres des faux jeux" Style="{StaticResource SetTitle}"/>
                    <TextBlock Text="Visibles, ou réduites dans la barre des tâches." Style="{StaticResource SetDesc}"/>
                  </StackPanel>
                  <Button x:Name="BtnWinMode" Style="{StaticResource Chip}" Content="Visibles" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SetRow}">
                <Grid>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,250,0">
                    <TextBlock Text="Couleur" Style="{StaticResource SetTitle}"/>
                    <TextBlock x:Name="StubColorName" Text="Comme l'accent" Style="{StaticResource SetDesc}"/>
                  </StackPanel>
                  <StackPanel x:Name="StubColorList" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SetRow}">
                <Grid>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Taille" Style="{StaticResource SetTitle}"/>
                    <TextBlock Text="Taille de la carte du faux jeu." Style="{StaticResource SetDesc}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="StubSizeS" Style="{StaticResource Seg}" Content="Petite"/>
                    <Button x:Name="StubSizeM" Style="{StaticResource Seg}" Content="Moyenne"/>
                    <Button x:Name="StubSizeL" Style="{StaticResource Seg}" Content="Grande"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Style="{StaticResource SetRow}">
                <Grid>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Position" Style="{StaticResource SetTitle}"/>
                    <TextBlock x:Name="StubCornerName" Text="En bas à droite de l'écran" Style="{StaticResource SetDesc}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="StubPosTL" Style="{StaticResource Seg}" Content="↖" FontSize="14" ToolTip="En haut à gauche"/>
                    <Button x:Name="StubPosTR" Style="{StaticResource Seg}" Content="↗" FontSize="14" ToolTip="En haut à droite"/>
                    <Button x:Name="StubPosBL" Style="{StaticResource Seg}" Content="↙" FontSize="14" ToolTip="En bas à gauche"/>
                    <Button x:Name="StubPosBR" Style="{StaticResource Seg}" Content="↘" FontSize="14" ToolTip="En bas à droite"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Style="{StaticResource SetRow}">
                <Grid>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,130,0">
                    <TextBlock Text="Aperçu" Style="{StaticResource SetTitle}"/>
                    <TextBlock Text="Affiche un faux jeu d'exemple pendant 6 secondes avec ces réglages." Style="{StaticResource SetDesc}"/>
                  </StackPanel>
                  <Button x:Name="BtnStubPreview" Style="{StaticResource Chip}" Content="Voir l'aperçu" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </Border>

              <TextBlock Text="Maintenance" Style="{StaticResource SetHead}"/>
              <Border Style="{StaticResource SetRow}">
                <Grid>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,130,0">
                    <TextBlock Text="Catalogue des jeux" Style="{StaticResource SetTitle}"/>
                    <TextBlock x:Name="CatalogDesc" Text="Mis à jour automatiquement toutes les 24 h." Style="{StaticResource SetDesc}"/>
                  </StackPanel>
                  <Button x:Name="BtnRefresh" Style="{StaticResource Chip}" Content="Actualiser" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SetRow}">
                <Grid>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,130,0">
                    <TextBlock Text="Nettoyer le dossier games" Style="{StaticResource SetTitle}"/>
                    <TextBlock Text="Supprime les faux exe inutilisés (les sessions en cours sont conservées)." Style="{StaticResource SetDesc}"/>
                  </StackPanel>
                  <Button x:Name="BtnClean" Style="{StaticResource Chip}" Content="Nettoyer" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SetRow}" BorderThickness="0">
                <StackPanel>
                  <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,130,0">
                      <TextBlock Text="Diagnostic" Style="{StaticResource SetTitle}"/>
                      <TextBlock Text="Vérifie Discord, le faux exe, le catalogue et le reste en un clic." Style="{StaticResource SetDesc}"/>
                    </StackPanel>
                    <Button x:Name="BtnDiag" Style="{StaticResource Chip}" Content="Lancer" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>
                  <StackPanel x:Name="DiagList" Margin="0,10,0,0"/>
                </StackPanel>
              </Border>

              <TextBlock Text="Raccourcis clavier" Style="{StaticResource SetHead}"/>
              <Grid Margin="0,8,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock FontSize="12.5" Foreground="{StaticResource Text}" LineHeight="22"
                           Text="Ctrl+Alt+S&#x0a;Ctrl+F&#x0a;Entrée&#x0a;Ctrl+Entrée&#x0a;Ctrl+D&#x0a;Suppr&#x0a;Échap"/>
                <TextBlock Grid.Column="1" FontSize="12.5" Foreground="{StaticResource Muted}" LineHeight="22"
                           Text="pause / reprise de la rotation, même outil caché&#x0a;chercher un jeu&#x0a;lancer le jeu sélectionné&#x0a;ajouter à la rotation&#x0a;favori&#x0a;arrêter la dernière session&#x0a;effacer la recherche, fermer les réglages"/>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
